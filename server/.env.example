# Nexora Server Environment Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# MongoDB Connection URI
MONGO_URI=mongodb://127.0.0.1:27017/nexora

# JWT Authentication Secret
JWT_SECRET=change_this_to_a_secure_random_64_character_string_for_production
JWT_EXPIRES_IN=30d

# Storage root folder on the Arch Linux 500GB HDD
STORAGE_ROOT=/var/nexora/storage

# CORS Allowed Origin (* for open or http://localhost:5173 for local dev)
CLIENT_ORIGIN=*
